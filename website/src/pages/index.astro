---
import Layout from '../layouts/Layout.astro';

const githubUrl = 'https://github.com/maxistar/Voice-Inbox';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const testingUrl = `${base}/testing/`;
const androidScreenshot = `${base}/screenshots/android-inbox.jpg`;
const androidWorkflowsIllustration = `${base}/screenshots/android-workflows.png`;
---
<Layout
  title="Local voice transcription"
  description="Voice Inbox turns shared audio recordings and short Android dictation into readable local transcripts. Android is ready; iOS is an active MVP."
>
  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.75fr);
      gap: 42px;
      align-items: center;
      min-height: 560px;
    }
    .hero-copy p {
      max-width: 640px;
      font-size: 1.12rem;
    }
    .hero-visual {
      border: 1px solid var(--border);
      border-radius: 28px;
      background: linear-gradient(180deg, #eff6ff, #ffffff);
      box-shadow: var(--shadow);
      padding: 18px;
    }
    .screenshot-shell {
      border: 10px solid #111827;
      border-radius: 28px;
      background: #f8fafc;
      overflow: hidden;
      max-height: 620px;
    }
    .screenshot-shell img {
      display: block;
      width: 100%;
      height: auto;
    }
    .caption {
      margin: 14px 0 0;
      color: var(--soft);
      font-size: 0.9rem;
      text-align: center;
    }
    .workflow-visual { margin: 0; }
    .workflow-visual img {
      display: block;
      width: 100%;
      height: auto;
    }
    .platform-card {
      display: grid;
      gap: 12px;
    }
    .use-case-card {
      display: grid;
      align-content: start;
      gap: 10px;
      min-height: 184px;
    }
    .use-case-card p {
      margin-bottom: 0;
    }
    .platform-tag {
      display: inline-flex;
      width: fit-content;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 4px 9px;
      color: var(--soft);
      background: var(--surface-strong);
      font-size: 0.74rem;
      font-weight: 800;
    }
    .status-badge {
      display: inline-flex;
      width: fit-content;
      border-radius: 999px;
      padding: 5px 10px;
      color: var(--accent-strong);
      background: var(--accent-soft);
      font-size: 0.78rem;
      font-weight: 850;
    }
    .flow {
      counter-reset: flow;
    }
    .flow .card {
      position: relative;
      padding-left: 58px;
    }
    .flow .card::before {
      counter-increment: flow;
      content: counter(flow);
      position: absolute;
      left: 20px;
      top: 22px;
      width: 26px;
      height: 26px;
      border-radius: 8px;
      color: white;
      background: var(--accent);
      display: grid;
      place-items: center;
      font-weight: 900;
    }
    .requirements {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      padding: 24px;
    }
    @media (max-width: 860px) {
      .hero {
        grid-template-columns: 1fr;
        min-height: auto;
      }
    }
  </style>

  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Local-first voice note transcription</p>
      <h1>Turn audio into readable local transcripts.</h1>
      <p>
        Send an existing recording to Voice Inbox, transcribe it on your device, and review the text in the app.
        Android also has a compact voice keyboard for short phrases. iOS has an active MVP for importing,
        previewing, batch transcribing, and reviewing recordings locally.
      </p>
      <div class="button-row">
        <a class="button primary" href={testingUrl}>Join Android closed test</a>
        <a class="button" href={`${base}/setup/`}>Setup guide</a>
        <a class="button" href={githubUrl} target="_blank" rel="noopener">View source</a>
      </div>
    </div>

    <div class="hero-visual" aria-label="Voice Inbox app preview">
      <div class="screenshot-shell">
        <img src={androidScreenshot} alt="Voice Inbox Android app showing scanned audio files and playback actions" />
      </div>
      <p class="caption">Android task list with non-sensitive demonstration recordings ready for local transcription.</p>
    </div>
  </section>

  <section class="section">
    <p class="eyebrow">Use cases</p>
    <h2>Start with the audio you already have.</h2>
    <div class="grid">
      <article class="card use-case-card">
        <span class="platform-tag">Android and iOS MVP</span>
        <h3>Voice message from a messenger</h3>
        <p>Use Share to send an already-recorded voice message to Voice Inbox, then read its local transcript.</p>
      </article>
      <article class="card use-case-card">
        <span class="platform-tag">Android and iOS MVP</span>
        <h3>Voice note from your recorder</h3>
        <p>Keep recording in the app you already use, then import or share the audio when you want text.</p>
      </article>
      <article class="card use-case-card">
        <span class="platform-tag">Android and iOS MVP</span>
        <h3>Meeting, interview, or lecture</h3>
        <p>Preview a recording, transcribe one file or a batch, and review the result before choosing an export.</p>
      </article>
      <article class="card use-case-card">
        <span class="platform-tag">Android</span>
        <h3>Folder of new recordings</h3>
        <p>Select one folder and let Voice Inbox find new or changed audio files for an optional repeatable workflow.</p>
      </article>
      <article class="card use-case-card">
        <span class="platform-tag">Android</span>
        <h3>A thought while you are writing</h3>
        <p>Switch to the Voice Inbox keyboard and dictate a short phrase directly into an active text field.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <p class="eyebrow">Platform status</p>
    <h2>Android is in closed testing; iOS is catching up fast.</h2>
    <div class="grid">
      <div class="card platform-card">
        <span class="status-badge">Android closed test</span>
        <h3>Flexible task workflow</h3>
        <p>Import or receive recordings, scan an optional folder, preview tasks, transcribe one file or a batch, retry failures, schedule best-effort background runs, or dictate a short phrase with the Android-only voice keyboard.</p>
      </div>
      <div class="card platform-card">
        <span class="status-badge">iOS MVP</span>
        <h3>Foreground recording workflow</h3>
        <p>Use app-local, Share Extension, or selected-folder import; preview audio; batch transcribe; review transcripts; append output; and choose startup processing behavior. Scheduled or background transcription is not supported on iOS.</p>
      </div>
      <div class="card platform-card">
        <span class="status-badge">Shared core</span>
        <h3>Kotlin Multiplatform foundation</h3>
        <p>Catalog and transcription use cases are moving into shared code so Android and iOS can converge without hiding platform-specific storage and background limitations.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <p class="eyebrow">What it does</p>
    <h2>Process a recording inbox—or dictate a short phrase on Android.</h2>
    <div class="grid">
      <div class="card">
        <h3>Individual or folder transcription</h3>
        <p>Import or share individual recordings, or optionally select one folder and process only files that are new or changed.</p>
      </div>
      <div class="card">
        <h3>Local recognition</h3>
        <p>Download the model or install it from a compatible local folder. After installation, recognition runs on device instead of sending audio to an app cloud service.</p>
      </div>
      <div class="card">
        <h3>Review first, export when useful</h3>
        <p>Read each transcript in Voice Inbox. Optionally create or choose a <code>.md</code> or <code>.txt</code> document and append successful notes without replacing earlier content.</p>
      </div>
      <div class="card">
        <h3>Preview before processing</h3>
        <p>Play audio files from the list before deciding to transcribe them.</p>
      </div>
      <div class="card">
        <h3>Scheduled processing</h3>
        <p>On Android, optionally ask the app to run scheduled transcription around your chosen time. Exact execution is not guaranteed.</p>
      </div>
      <div class="card">
        <h3>Transparent history</h3>
        <p>Processed and failed files stay visible with their latest transcript or error, and failed files can be retried individually.</p>
      </div>
      <div class="card">
        <h3>Android voice keyboard</h3>
        <p>Record a short phrase in a compact Android input method and insert the locally recognized result into the active editable field. It is not a full typing keyboard and is not available on iOS.</p>
        <a href={`${base}/docs/voice-keyboard/`}>Read the keyboard guide →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <p class="eyebrow">Current product workflows</p>
    <h2>Keep recordings organized or dictate where you are writing.</h2>
    <figure class="workflow-visual">
      <img
        src={androidWorkflowsIllustration}
        alt="Three Android Voice Inbox views showing the recording task list, startup and scheduled-processing settings, and the compact voice keyboard inside a text editor"
      />
      <figcaption class="caption">
        Android recording, automation, and short-phrase dictation workflows shown with demonstration content.
      </figcaption>
    </figure>
  </section>

  <section class="section">
    <p class="eyebrow">Workflow</p>
    <h2>From existing audio to local text.</h2>
    <div class="grid flow">
      <div class="card"><h3>Install the model</h3><p>Download and verify the model, or install it from a compatible local folder.</p></div>
      <div class="card"><h3>Add audio</h3><p>Import a file, send one through Share, or optionally select an audio folder.</p></div>
      <div class="card"><h3>Transcribe and review</h3><p>Preview the recording if needed, then read the recognized text in Voice Inbox.</p></div>
      <div class="card"><h3>Export or automate later</h3><p>Optionally append transcripts to a Markdown or text document, choose startup behavior, or enable Android scheduling.</p></div>
    </div>
  </section>

  <section class="section requirements">
    <p class="eyebrow">Requirements</p>
    <h2>Designed for local, on-device recognition.</h2>
    <p>
      Android requires Android 7.0 (API 24) or later on an ARM64 device. Both Android and the iOS MVP
      need network access for the first model download and enough free storage for model installation.
    </p>
    <div class="button-row">
      <a class="button primary" href={testingUrl}>Join Android closed test</a>
      <a class="button" href={`${base}/faq/`}>Read FAQ</a>
    </div>
  </section>
</Layout>
